{% extends "base.html.twig" %}

{% block content %}
<div class="page-modifiercompte">
    <h2>✏️ Modifier un compte</h2>

    {# ── Liste des utilisateurs ─────────────────────────────────── #}
    {% if not user_info %}
    <section>
        <h3>Utilisateurs enregistrés</h3>

        <form method="GET" style="display:flex;gap:10px;margin-bottom:18px;flex-wrap:wrap;">
            <input type="text" name="search" value="{{ search }}"
                   placeholder="Rechercher (nom, prénom, login, email)…"
                   style="flex:1;min-width:200px;">
            <select name="user_type">
                <option value="">Tous les types</option>
                {% for key, label in user_types %}
                <option value="{{ key }}" {% if type_filter == key %}selected{% endif %}>{{ label }}</option>
                {% endfor %}
            </select>
            <button type="submit" class="btn btn-secondary">Filtrer</button>
            {% if search or type_filter %}
            <a href="modifiercompte.php" class="btn btn-secondary">✕ Réinitialiser</a>
            {% endif %}
        </form>

        {% if users %}
        <div class="table-responsive">
        <table>
            <thead>
                <tr>
                    <th>Login</th>
                    <th>Nom</th>
                    <th>Prénom</th>
                    <th>Email</th>
                    <th>Type</th>
                    <th>Statut</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                {% for u in users %}
                <tr>
                    <td><code>{{ u.login }}</code></td>
                    <td>{{ u.nom }}</td>
                    <td>{{ u.prenom }}</td>
                    <td>{{ u.email }}</td>
                    <td>
                        {% if u.user_type == 'permanent' %}
                            <span class="badge badge-info">Permanent</span>
                        {% elseif u.user_type == 'stagiaires' %}
                            <span class="badge badge-warning">Stagiaire</span>
                        {% else %}
                            <span class="badge">{{ u.user_type }}</span>
                        {% endif %}
                    </td>
                    <td>
                        {% if u.account_enabled %}
                            <span style="color:var(--success-color);font-weight:600;">● Actif</span>
                        {% else %}
                            <span style="color:var(--text-tertiary);">○ Inactif</span>
                        {% endif %}
                    </td>
                    <td>
                        <form method="POST" style="margin:0;">
                            <input type="hidden" name="action" value="search">
                            <input type="hidden" name="login" value="{{ u.login }}">
                            <button type="submit" class="btn btn-primary btn-xs">Modifier</button>
                        </form>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
        </div>
        <p style="margin-top:10px;color:var(--text-secondary);font-size:12px;">
            {{ users|length }} utilisateur{{ users|length > 1 ? 's' : '' }}
            {% if search or type_filter %} correspondant aux filtres{% endif %}
        </p>
        {% else %}
        <p style="color:var(--text-secondary);padding:20px 0;">Aucun utilisateur trouvé.</p>
        {% endif %}
    </section>

    {# ── Formulaire de modification ─────────────────────────────── #}
    {% else %}

    {# Message de retour #}
    {% if message %}
    <div class="message message-{{ messageType }}">
        <span class="message-icon">
            {% if messageType == 'success' %}✔{% elseif messageType == 'error' %}✖{% elseif messageType == 'warning' %}⚠{% else %}ℹ{% endif %}
        </span>
        <span>{{ message }}</span>
    </div>
    {% endif %}

    <form method="POST" class="form-update">
        <input type="hidden" name="action"  value="update">
        <input type="hidden" name="login"   value="{{ user_info.login }}">
        <input type="hidden" name="user_id" value="{{ user_info.id }}">

        <fieldset>
            <legend>Identité</legend>
            <div class="form-row">
                <div class="form-group col-4">
                    <label for="edit_login">Login</label>
                    <input type="text" id="edit_login" name="new_login"
                           value="{{ user_info.login }}"
                           placeholder="{{ user_info.login }}"
                           {% if user_info._ad_only %}disabled{% endif %}>
                    <small class="form-text" style="color:var(--warning-color,#e67e22);">⚠ Modifier le login le changera dans AD, OpenLDAP et MySQL.</small>
                </div>
                <div class="form-group col-4">
                    <label for="edit_nom">Nom</label>
                    <input type="text" id="edit_nom" name="nom"
                           value="{{ user_info.nom }}"
                           {% if user_info._ad_only %}disabled{% endif %}>
                </div>
                <div class="form-group col-4">
                    <label for="edit_prenom">Prénom</label>
                    <input type="text" id="edit_prenom" name="prenom"
                           value="{{ user_info.prenom }}"
                           {% if user_info._ad_only %}disabled{% endif %}>
                </div>
            </div>
            <div id="login-regen-warning" style="display:none;padding:8px 12px;background:var(--warning-bg,#fff3cd);border-left:3px solid var(--warning-color,#e67e22);border-radius:4px;margin-top:4px;font-size:13px;">
                ⚠ Le login sera régénéré automatiquement d'après le nouveau nom/prénom (sauf si vous en saisissez un manuellement ci-dessus).
            </div>
            {% if user_info.user_type %}
            <div class="form-group">
                <label>Type de compte</label>
                <input type="text" value="{{ user_info.user_type }}" disabled>
            </div>
            {% endif %}
        </fieldset>

        {% if not user_info._ad_only %}
        <fieldset>
            <legend>Coordonnées</legend>
            <div class="form-row">
                <div class="form-group col-6">
                    <label for="email">Email</label>
                    <input type="email" id="email" name="email"
                           value="{{ user_info.email }}"
                           placeholder="Laisser vide pour ne pas modifier">
                </div>
                <div class="form-group col-6">
                    <label for="telephone">Téléphone</label>
                    <input type="tel" id="telephone" name="telephone"
                           value="{{ user_info.telephone }}"
                           placeholder="Laisser vide pour ne pas modifier">
                </div>
            </div>
        </fieldset>

        <fieldset>
            <legend>Informations professionnelles</legend>
            <div class="form-row">
                <div class="form-group col-6">
                    <label for="titre">Titre / Fonction</label>
                    <input type="text" id="titre" name="titre"
                           value="{{ user_info.titre }}"
                           placeholder="Ex : Ingénieur, Maître de conférences…">
                </div>
                <div class="form-group col-6">
                    <label for="departement">Département</label>
                    <input type="text" id="departement" name="departement"
                           value="{{ user_info.departement }}"
                           placeholder="Ex : Informatique, RH…">
                </div>
            </div>
            <div class="form-group">
                <label for="description">Description / Notes internes</label>
                <textarea id="description" name="description" rows="2"
                          placeholder="Laisser vide pour ne pas modifier">{{ user_info.description }}</textarea>
            </div>
        </fieldset>

        <fieldset>
            <legend>Informations personnelles</legend>
            <div class="form-row">
                <div class="form-group col-6">
                    <label for="nationalite">Nationalité</label>
                    <input type="text" id="nationalite" name="nationalite"
                           list="list-nationalites"
                           value="{{ user_info.nationalite }}"
                           placeholder="Rechercher une nationalité…"
                           autocomplete="off">
                    <datalist id="list-nationalites">
                        {% for nat in nationalites %}
                        <option value="{{ nat }}">
                        {% endfor %}
                    </datalist>
                </div>
                <div class="form-group col-6">
                    <label for="lieu_naissance">Lieu de naissance</label>
                    <input type="text" id="lieu_naissance" name="lieu_naissance"
                           list="list-villes"
                           value="{{ user_info.lieu_naissance }}"
                           placeholder="Rechercher une ville…"
                           autocomplete="off">
                    <datalist id="list-villes">
                        {% for ville in villes %}
                        <option value="{{ ville }}">
                        {% endfor %}
                    </datalist>
                </div>
            </div>
        </fieldset>

        <div class="form-actions">
            <button type="submit" class="btn btn-primary btn-lg">Enregistrer et synchroniser</button>
            <a href="modifiercompte.php" class="btn btn-secondary">← Retour à la liste</a>
        </div>

        {% else %}
        <div class="message message-warning">
            <span class="message-icon">&#x26A0;</span>
            <span>Cet utilisateur n'est pas enregistré en base — modification impossible via cette interface.</span>
        </div>
        <div class="form-actions">
            <a href="modifiercompte.php" class="btn btn-secondary">← Retour à la liste</a>
        </div>
        {% endif %}
    </form>

    {# ── Zone de suppression ────────────────────────────────────── #}
    {% if not user_info._ad_only %}
    <fieldset class="fieldset-danger" style="margin-top:32px;border:2px solid var(--error-color,#c0392b);border-radius:6px;padding:20px 24px;">
        <legend style="color:var(--error-color,#c0392b);font-weight:700;padding:0 8px;">🗑 Zone de danger — Suppression du compte</legend>

        <p style="margin:0 0 6px;color:var(--text-secondary);">
            Cette action supprimera définitivement <strong>{{ user_info.prenom }} {{ user_info.nom }}</strong>
            (<code>{{ user_info.login }}</code>) de <strong>tous les systèmes</strong> :
            Active Directory, OpenLDAP et Aurion, ainsi que de la base MySQL.
        </p>
        <p style="margin:0 0 16px;color:var(--error-color,#c0392b);font-weight:600;">
            ⚠ Cette opération est irréversible.
        </p>

        <form method="POST" id="form-delete" onsubmit="return validerSuppression()">
            <input type="hidden" name="action"  value="delete">
            <input type="hidden" name="user_id" value="{{ user_info.id }}">
            <input type="hidden" name="login"   value="{{ user_info.login }}">

            <div class="form-group" style="max-width:340px;">
                <label for="confirmation" style="font-weight:600;">
                    Pour confirmer, tapez exactement : <code style="background:var(--bg-secondary,#f4f4f4);padding:2px 6px;border-radius:3px;">Oui.</code>
                </label>
                <input type="text"
                       id="confirmation"
                       name="confirmation"
                       autocomplete="off"
                       placeholder="Oui."
                       style="margin-top:8px;border-color:var(--error-color,#c0392b);">
            </div>

            <button type="submit"
                    id="btn-delete"
                    class="btn btn-danger"
                    style="background:var(--error-color,#c0392b);color:#fff;border:none;cursor:pointer;margin-top:4px;"
                    disabled>
                🗑 Supprimer définitivement
            </button>
        </form>
    </fieldset>
    {% endif %}

    {% endif %}

    {# ── Message hors fiche utilisateur (liste) ─────────────────── #}
    {% if message and not user_info %}
    <div class="message message-{{ messageType }}" style="margin-top:16px;">
        <span class="message-icon">
            {% if messageType == 'success' %}✔{% elseif messageType == 'error' %}✖{% elseif messageType == 'warning' %}⚠{% else %}ℹ{% endif %}
        </span>
        <span>{{ message }}</span>
    </div>
    {% endif %}

</div>
{% endblock %}

{% block extra_js %}
<script>
(function() {
    // ── Régénération login sur changement nom/prénom ──────────────
    const nomInput    = document.getElementById('edit_nom');
    const prenomInput = document.getElementById('edit_prenom');
    const loginInput  = document.getElementById('edit_login');
    const warning     = document.getElementById('login-regen-warning');

    if (nomInput && prenomInput && loginInput) {
        let loginManuallyEdited = false;

        function slugify(str) {
            return str.toLowerCase()
                .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
                .replace(/[^a-z0-9]/g, '');
        }

        function regenLogin() {
            if (loginManuallyEdited) return;
            const p = slugify(prenomInput.value);
            const n = slugify(nomInput.value);
            if (p && n) loginInput.value = p[0] + '.' + n;
        }

        nomInput.addEventListener('input', function() {
            regenLogin();
            warning.style.display = (
                nomInput.value !== nomInput.defaultValue ||
                prenomInput.value !== prenomInput.defaultValue
            ) ? 'block' : 'none';
        });

        prenomInput.addEventListener('input', function() {
            regenLogin();
            warning.style.display = (
                nomInput.value !== nomInput.defaultValue ||
                prenomInput.value !== prenomInput.defaultValue
            ) ? 'block' : 'none';
        });

        loginInput.addEventListener('input', function() {
            loginManuallyEdited = true;
        });
    }

    // ── Activation du bouton supprimer ────────────────────────────
    const confirmInput = document.getElementById('confirmation');
    const btnDelete    = document.getElementById('btn-delete');

    if (confirmInput && btnDelete) {
        confirmInput.addEventListener('input', function() {
            btnDelete.disabled = (confirmInput.value !== 'Oui.');
        });
    }
})();

// Validation côté client avant soumission
function validerSuppression() {
    const val = document.getElementById('confirmation').value;
    if (val !== 'Oui.') {
        alert('Confirmation incorrecte. Tapez exactement : Oui. (avec le point)');
        return false;
    }
    return confirm('Dernière chance — supprimer définitivement ce compte de tous les systèmes ?');
}
</script>
{% endblock %}
